HUB_API_KEY=hub_your_api_key_here

# Scoped Atlassian API token (read:jira-work, read:jira-user, read:account) used
# only by capex_component_audit.py. Unlike JIRA_TOKEN (a classic full-access
# token, used against the site domain directly), scoped tokens are rejected by
# https://{site}/rest/api/3/... and must go through the api.atlassian.com
# gateway — src/jira_client.py's search_issues()/verify_auth() already do this.
CAPEX_TRACKER=your_scoped_jira_api_token_here
